{
  "name": "Habit Maker",
  "short_name": "Habits",
  "description": "Local-first habit tracker. All data stays on your device.",
  "lang": "en",
  "_comment_id": "No explicit \"id\": it resolves against the ORIGIN, not the manifest URL, so \"./\" would mean https://host/ and orphan every existing install. The implicit default (start_url) is already correct.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "categories": ["productivity", "lifestyle"],
  "theme_color": "#050914",
  "background_color": "#050914",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
